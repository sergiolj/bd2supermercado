# Copie este arquivo para ".env" (mesma pasta) e ajuste com os dados do seu PostgreSQL.
# O arquivo ".env" NÃO é versionado.
# Ele é lido pela aplicação (Spring) e pelo docker compose: não use aspas nem o caractere $ nos valores.

# Porta do PostgreSQL na sua máquina.
#   Sem Docker: a porta do seu PostgreSQL local (normalmente 5432).
#   Com Docker: a porta em que o container será publicado. Se a 5432 já estiver ocupada, use outra (ex.: 5544).
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=sua_senha_aqui

# Porta da API (Swagger em http://localhost:8080/swagger-ui/index.html). Troque se a 8080 já estiver em uso.
API_PORT=8080

# Opcional: URL JDBC completa. Se definida, a aplicação ignora DB_PORT (o docker compose continua usando DB_PORT).
# DB_URL=jdbc:postgresql://localhost:5432/grocery
